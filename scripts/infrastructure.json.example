{
  "_comment": "Kopieren nach scripts/infrastructure.json und anpassen. Keine Geheimnisse in diese Datei schreiben: Werte aus der .env landen im Key Vault, das Entra-Client-Secret wird vom Skript erzeugt und ebenfalls dort abgelegt.",
  "subscriptionId": "",
  "resourceGroup": "rg-policy-studio",
  "location": "westeurope",
  "tags": {
    "project": "policy-studio"
  },
  "appServicePlan": {
    "name": "asp-policy-studio",
    "sku": "F1",
    "resourceGroup": "",
    "useExisting": false
  },
  "webApp": {
    "name": "policy-studio-CHANGE-ME",
    "runtime": "NODE:22-lts",
    "startupCommand": "npm start",
    "httpsOnly": true,
    "minTlsVersion": "1.2"
  },
  "appSettings": {
    "NODE_ENV": "production"
  },
  "keyVault": {
    "name": "kv-policy-CHANGE-ME",
    "sku": "standard",
    "retentionDays": 7,
    "purgeProtection": false,
    "envFile": "../.env",
    "envExclude": ["PORT"]
  },
  "entra": {
    "enabled": true,
    "application": {
      "displayName": "Policy Studio",
      "signInAudience": "AzureADMyOrg",
      "additionalRedirectUris": []
    },
    "clientSecret": {
      "secretName": "entra-client-secret",
      "validityYears": 1
    },
    "assignmentRequired": true,
    "assignedUsers": [],
    "assignedGroups": [],
    "excludedPaths": ["/healthz"]
  },
  "foundry": {
    "resourceId": ""
  },
  "allowedIpRanges": [],
  "deployment": {
    "buildFrontend": true,
    "healthCheckPath": "/healthz",
    "healthCheckTimeoutSeconds": 300
  }
}

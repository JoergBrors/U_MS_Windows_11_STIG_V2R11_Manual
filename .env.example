# Optional server-side default. Values configured in the browser override these.
AI_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# OpenAI API
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-5-mini

# Google AI / Gemini
# AI_PROVIDER=google
# GOOGLE_AI_API_KEY=replace-me
# GOOGLE_AI_MODEL=gemini-flash-latest

# App-Metadaten für den „Über“-Dialog (nicht geheim; nur diese APP_*-Werte werden an den Browser ausgeliefert)

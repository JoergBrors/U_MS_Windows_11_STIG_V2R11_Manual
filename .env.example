# Optional server-side default. Values configured in the browser override these.
AI_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# OpenAI API
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-5-mini

# Google AI / Gemini
# AI_PROVIDER=google
# GOOGLE_AI_API_KEY=replace-me
# GOOGLE_AI_MODEL=gemini-flash-latest

# App-Metadaten für den „Über“-Dialog (nicht geheim; nur diese APP_*-Werte werden an den Browser ausgeliefert)
# APP_NAME=Policy Studio
# APP_VERSION=1.0.0
# APP_DESCRIPTION=STIG-Regeln analysieren und in Automatisierung überführen
# APP_AUTHOR=Vorname Nachname
# APP_CONTACT=name@example.com
# APP_LICENSE=MIT
# APP_REPOSITORY_URL=https://github.com/JoergBrors/…

# Claude (Anthropic)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=x
# ANTHROPIC_MODEL=claude-opus-5-5
# Azure Claude (Microsoft Foundry): Endpoint der Ressource, Deployment-Name und Authentifizierung
# AI_PROVIDER=foundry
# FOUNDRY_ENDPOINT=https://RESSOURCE.services.ai.azure.com/anthropic
# FOUNDRY_DEPLOYMENT=claude-haiku-4-5
# apikey oder entra (bei entra ist kein Schlüssel nötig)
# FOUNDRY_AUTH=apikey
# FOUNDRY_API_KEY=x
